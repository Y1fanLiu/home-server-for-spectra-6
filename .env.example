PORT=80
HOST=0.0.0.0
PHOTOFRAME_URL=http://photoframe.local
# Optional: set this if the PhotoFrame API is protected with a password.
PHOTOFRAME_PASSWORD=
# Optional: enable AI image generation. Add one or both provider keys.
OPENAI_API_KEY=
GEMINI_API_KEY= 
# Optional model overrides for AI image generation.
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Optional: create a free TMDB API key to enable current and popular movie posters.
TMDB_API_KEY=